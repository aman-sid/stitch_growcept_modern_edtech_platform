# =============================================================================
# 100x MINDS — Environment Variables
# Duplicate this file as .env.local for local development
# Add these variables to your Cloudflare Pages / Workers project settings
# =============================================================================

# Admin Dashboard Authentication Credentials
ADMIN_EMAIL="admin@100xminds.ai"
ADMIN_PASSWORD="admin100x"
AUTH_SECRET="100x-minds-super-secure-admin-secret-key-2025"

# Supabase Public API (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role Secret Key (Server-only / Edge Route Handlers)
# DO NOT expose this key on client-side components
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Site URL for canonical routing & OG generation
NEXT_PUBLIC_SITE_URL="https://100xminds.ai"
